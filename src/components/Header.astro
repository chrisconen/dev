---
import { SITE } from '../config';

interface Props {
  current?: string;
}

const { current = '' } = Astro.props;
---

<header class="site-header">
  <div class="shell bar">
    <a class="wordmark" href="/">Chris Conen</a>
    <nav class="site-nav" aria-label="Site">
      <a href="/#evidence">Evidence</a>
      <a href="/axr/" aria-current={current === 'axr' ? 'page' : undefined}>AXR</a>
      <a href="/writing/" aria-current={current === 'writing' ? 'page' : undefined}>Writing</a>
      <a href="/receipt/" aria-current={current === 'receipt' ? 'page' : undefined}>Site Proof</a>
      <a href={SITE.github} rel="me noopener">GitHub</a>
    </nav>
  </div>
</header>
