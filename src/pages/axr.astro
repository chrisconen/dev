---
import Base from '../layouts/Base.astro';
import AxrPage from '../components/AxrPage.astro';
import { AXR, LOCALES } from '../i18n/axr';
import { SITE } from '../config';

// English (canonical) /axr. Body lives in AxrPage; content in the shared i18n
// dictionary. Localized routes: /<lang>/axr/ via src/pages/[lang]/axr/index.astro.
const lang = 'en';
const t = AXR[lang];
const enPath = '/axr/';

const alternates = [
  { hreflang: 'en', href: SITE.url + enPath },
  ...LOCALES.filter((l) => l !== 'en').map((l) => ({ hreflang: l, href: `${SITE.url}/${l}${enPath}` })),
  { hreflang: 'x-default', href: SITE.url + enPath },
];

const JSONLD = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: 'AXR — Agent eXecution Receipts',
    alternateName: 'AXR',
    description: t.meta.description,
    url: SITE.url + enPath,
    inLanguage: lang,
    codeRepository: SITE.axrRepo,
    programmingLanguage: ['JavaScript', 'Python'],
    license: 'https://opensource.org/licenses/MIT',
    keywords: [
      'agent execution receipt',
      'AI agent accountability',
      'tamper-evident audit trail for AI agents',
      'verifiable agent logs',
      'n8n audit log',
      'EU AI Act Article 12 logging',
      'Ed25519 signed receipts',
    ],
    author: { '@type': 'Person', name: 'Chris Conen', url: SITE.url },
  },
];
---

<Base
  current="axr"
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={JSONLD}
  lang={lang}
  alternates={alternates}
>
  <AxrPage t={t} lang={lang} locales={LOCALES} />
</Base>
