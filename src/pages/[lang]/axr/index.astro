---
import Base from '../../../layouts/Base.astro';
import AxrPage from '../../../components/AxrPage.astro';
import { AXR, LOCALES } from '../../../i18n/axr';
import { SITE } from '../../../config';

// Localized /<lang>/axr/ routes. English canonical lives at /axr/.
export function getStaticPaths() {
  return LOCALES.filter((l) => l !== 'en').map((l) => ({ params: { lang: l } }));
}

const { lang } = Astro.params as { lang: string };
const t = AXR[lang];
const enPath = '/axr/';
const selfUrl = `${SITE.url}/${lang}${enPath}`;

const alternates = [
  { hreflang: 'en', href: SITE.url + enPath },
  ...LOCALES.filter((l) => l !== 'en').map((l) => ({ hreflang: l, href: `${SITE.url}/${l}${enPath}` })),
  { hreflang: 'x-default', href: SITE.url + enPath },
];

const JSONLD = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: 'AXR — Agent eXecution Receipts',
    alternateName: 'AXR',
    description: t.meta.description,
    url: selfUrl,
    inLanguage: lang,
    codeRepository: SITE.axrRepo,
    programmingLanguage: ['JavaScript', 'Python'],
    license: 'https://opensource.org/licenses/MIT',
    keywords: [
      'tamper-evident audit trail for AI agents',
      'verifiable agent logs',
      'n8n audit log',
      'AI agent accountability',
      'EU AI Act Article 12 logging',
      'Ed25519 signed receipts',
    ],
    author: { '@type': 'Person', name: 'Chris Conen', url: SITE.url },
  },
];
---

<Base
  current="axr"
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={JSONLD}
  lang={lang}
  alternates={alternates}
>
  <AxrPage t={t} lang={lang} locales={LOCALES} />
</Base>
