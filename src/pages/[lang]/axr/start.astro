---
import Base from '../../../layouts/Base.astro';
import StartPage from '../../../components/StartPage.astro';
import { START, LOCALES } from '../../../i18n/start';
import { SITE } from '../../../config';

// Localized /<lang>/axr/start/ routes. One template renders any non-English
// locale from the shared dictionary; the English canonical lives at /axr/start/.
export function getStaticPaths() {
  return LOCALES.filter((l) => l !== 'en').map((l) => ({ params: { lang: l } }));
}

const { lang } = Astro.params as { lang: string };
const t = START[lang];
const enPath = '/axr/start/';
const selfUrl = `${SITE.url}/${lang}${enPath}`;

const alternates = [
  { hreflang: 'en', href: SITE.url + enPath },
  ...LOCALES.filter((l) => l !== 'en').map((l) => ({ hreflang: l, href: `${SITE.url}/${l}${enPath}` })),
  { hreflang: 'x-default', href: SITE.url + enPath },
];

const deq = (s: string) => s.replace(/^[„"”]+/, '').replace(/[„"”]+$/, '');
const JSONLD = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: t.meta.title,
    description: t.meta.description,
    url: selfUrl,
    inLanguage: lang,
    isPartOf: { '@type': 'SoftwareSourceCode', name: 'AXR', url: 'https://chrisconen.dev/axr/' },
    about: { '@type': 'SoftwareSourceCode', name: 'AXR — Agent eXecution Receipts', url: 'https://chrisconen.dev/axr/' },
    author: { '@type': 'Person', name: 'Chris Conen', url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.items.map((f: any) => ({
      '@type': 'Question',
      name: deq(f.q),
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  current="axr"
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={JSONLD}
  lang={lang}
  alternates={alternates}
>
  <StartPage t={t} lang={lang} locales={LOCALES} />
</Base>
