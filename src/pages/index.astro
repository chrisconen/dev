---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import ReceiptStrip from '../components/ReceiptStrip.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import { SITE, EVIDENCE } from '../config';

const lastUpdated = new Date().toISOString().slice(0, 10);

// JSON-LD: Chris Conen as a person entity, so a recruiter's search and Google's
// knowledge graph can resolve the name to this site, AXR, and the relocation
// intent. Only claims already visible on the page.
const JSONLD = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Chris Conen',
    url: SITE.url,
    description:
      'Builder and operator moving into security governance and AI assurance; ' +
      'creator of AXR, open-source signed execution receipts for AI agents.',
    knowsAbout: [
      'AI assurance',
      'security governance',
      'GRC',
      'tamper-evident audit trails',
      'n8n automation',
      'EU AI Act compliance',
    ],
    sameAs: [SITE.github, SITE.linkedin].filter(Boolean),
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Budapest',
      addressCountry: 'HU',
    },
    makesOffer: {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'SoftwareSourceCode',
        name: 'AXR — Agent eXecution Receipts',
        url: 'https://chrisconen.dev/axr/',
        codeRepository: SITE.axrRepo,
      },
    },
  },
];
---

<Base current="home" jsonLd={JSONLD}>
  <div class="shell hero">
    <div class="hero-content">
      <p class="kicker">
        Chris Conen<span class="sep">/</span>Builder and operator<span class="sep">/</span
        >Budapest, relocating to Australia
      </p>
      <h1>Proof over <em>promises.</em></h1>
      <p class="lede">
        I have shipped web products for fourteen years. Now I am building the
        accountability layer for AI agents: open-source, Ed25519-signed execution
        receipts that make what an agent did independently verifiable — the
        direction the EU AI Act's record-keeping rules and NIST's new agent
        standards work are already pointing.
      </p>
      <nav class="hero-paths" aria-label="Choose your path">
        <a class="hero-path" href="/#evidence">
          <span class="hp-who">Hiring · security / GRC / AI assurance</span>
          <span class="hp-go">See the evidence &rarr;</span>
        </a>
        <a class="hero-path" href="/axr/start/">
          <span class="hp-who">You run AI in your business</span>
          <span class="hp-go">AXR in plain English &rarr;</span>
        </a>
        <a class="hero-path" href="/axr/">
          <span class="hp-who">Builder or engineer</span>
          <span class="hp-go">The AXR protocol &rarr;</span>
        </a>
      </nav>
      <p class="hero-verify small muted">
        This page signs itself. <a href="/receipt/">Verify this site &rarr;</a>
      </p>
      <div class="chips">
        <span class="chip">Google Cybersecurity Certificate <strong>in progress</strong></span>
        <span class="chip">Open to sponsored roles <strong>security / GRC / AI assurance, AU</strong></span>
      </div>
    </div>
    <div class="hero-image-container">
      <!-- Desktop image (hidden on mobile) -->
      <img src="/images/chris-conen-cybersecurity-analyst.webp" alt="Chris Conen - Cybersecurity Analyst" class="hero-image desktop-only" />
      <!-- Mobile image (hidden on desktop) -->
      <img src="/images/chris-conen-cybersecurity-analyst_xs.webp" alt="Chris Conen - Cybersecurity Analyst" class="hero-image mobile-only" />
    </div>
  </div>

  <div class="shell">
    <ReceiptStrip />
  </div>

  <Entry label="The wedge" id="axr">
    <h2>AI agents act. AXR makes them show <em>receipts.</em></h2>
    <p>
      Agent logs are just files: editable after the fact, silent about what
      went missing. AXR, short for Agent eXecution Receipts, is my open-source
      answer. Consequential agent actions emit a signed, tamper-evident receipt
      of what ran, on which inputs, with what outcome. Anyone holding the
      public key can verify a receipt; nobody holding the log can quietly
      rewrite it.
    </p>
    <p>
      The timing is not academic. The EU AI Act makes automatic event logging a
      design requirement for high-risk systems, with obligations applying from
      2 August 2026, and NIST launched its AI Agent Standards Initiative in
      February 2026 with agent security and identity as core pillars. AXR is
      built to line up with where both are heading.
    </p>
    <p>
      This site eats its own cooking: every deploy publishes a signed build
      receipt you can check in your browser, right now.
    </p>
    <p class="small muted">
      Run AI in your business but don't write code? There's a plain-English
      version with a 30-second demo — and AXR itself is free and open source (MIT).
    </p>
    <div class="proof-strip">
      <p class="proof-lead">No testimonials, no logo wall — just things you can <em>check:</em></p>
      <ul class="proof-points">
        <li><strong>In production since June 2026</strong> on a live booking workflow — 200+ signed receipts, anchored hourly.</li>
        <li><strong>Four pre-existing bugs surfaced</strong> the week the receipts went in — none caused by AXR.</li>
        <li><strong>Two independent verifiers</strong> (Node + Python) agree byte-for-byte on every check.</li>
        <li><strong>Open source · MIT · zero runtime dependencies</strong> — read exactly how it works.</li>
      </ul>
      <a class="proof-cta" href="/axr/devlog/">Don't trust it — verify the dev-log yourself &rarr;</a>
    </div>
    <div class="btn-row">
      <a class="btn btn-ghost" href="/axr/start/">New to this? Plain English</a>
      <a class="btn btn-ghost" href="/axr/">How it works</a>
      <a class="btn btn-ghost" href={SITE.axrRepo} rel="noopener">AXR on GitHub</a>
    </div>
  </Entry>

  <Entry label="Evidence" id="evidence">
    <h2>Numbers someone else can <em>check.</em></h2>
    <p>
      Self-reported claims are cheap. These are externally measurable outcomes
      from things I have shipped and run.
    </p>
    <div class="evidence-grid">
      {EVIDENCE.map((item) => <EvidenceCard item={item} />)}
    </div>
    <p class="footnote">
      PageSpeed scores drift a few points run to run. Check them yourself —
      that is the point.
    </p>
  </Entry>

  <Entry label="Approach" id="approach">
    <h2>Builder first. Security depth, earned in <em>public.</em></h2>
    <p>
      I am a Hungarian-German builder and operator. For fourteen years I have
      designed, shipped and maintained web products, lately with heavily
      AI-assisted workflows. That is exactly why agent accountability matters
      to me: I rely on these systems every day, and I want them auditable.
    </p>
    <p>
      Running ECO Clean taught me the unglamorous half of assurance — process
      discipline, risk, and keeping promises to hundreds of customers. Those
      are the same muscles governance and compliance work runs on.
    </p>
    <p>
      To be precise about what I am not: I am not selling myself as a senior
      security engineer. I am a builder moving deliberately into security
      governance and AI assurance, with the Google Cybersecurity Certificate
      in progress and AXR as my working lab. Everything on this page is
      checkable, and that is by design.
    </p>
  </Entry>

  <Entry label="Now" id="now">
    <h2>Current <em>ledger.</em></h2>
    <ul class="now-list">
      <li>
        <span class="tag">Studying</span>
        <span>Google Cybersecurity Professional Certificate, in progress.</span>
      </li>
      <li>
        <span class="tag">Building</span>
        <span>AXR, in public — live in production, anchored hourly, with two independent verifiers. Now hardening key governance and independent monitoring.</span>
      </li>
      <li>
        <span class="tag">Moving</span>
        <span>
          Relocating to Australia. Open to employer-sponsored roles in
          security, GRC and AI assurance.
        </span>
      </li>
    </ul>
    <p class="footnote mono">Entry date {lastUpdated}, set at build time.</p>
  </Entry>

  <Entry label="Contact" id="contact">
    <h2>Hiring in <em>Australia?</em></h2>
    <p>
      If you are hiring for security, GRC or AI assurance and sponsorship is on
      the table, I will make the conversation worth your time. The fastest way
      to evaluate me is the <a href="/receipt/">receipt page</a> and the
      <a href={SITE.axrRepo} rel="noopener">AXR repository</a> — both are live.
    </p>
    <p>
      <a class="contact-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
    <p class="small muted">
      Also on <a href={SITE.github} rel="me noopener">GitHub</a>{SITE.linkedin && (
        <> and <a href={SITE.linkedin} rel="me noopener">LinkedIn</a></>
      )}.
    </p>
  </Entry>
</Base>

<style>
  /* Hero "three doors": let each of the three audiences (hiring, non-technical
     AXR, engineer) self-select above the fold, without diluting the "Proof over
     promises" career identity above. */
  .hero-paths {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 1.5rem 0 0.9rem;
    max-width: 34rem;
  }
  .hero-path {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0.95rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 120ms ease, background-color 120ms ease;
  }
  .hero-path:hover { border-color: var(--accent); background: var(--accent-wash); }
  .hp-who {
    font-family: var(--mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .hp-go { font-weight: 600; color: var(--accent-deep); white-space: nowrap; }
  .hero-verify { margin: 0.2rem 0 0; }
  @media (max-width: 30rem) {
    .hero-path { flex-direction: column; gap: 0.25rem; }
    .hp-go { white-space: normal; }
  }

  /* Honest social proof: no testimonials we don't have — checkable facts, the
     site's "proof over promises" ethos applied to the trust question. */
  .proof-strip {
    margin: 1.5rem 0 0.5rem;
    max-width: 40rem;
    padding: 1rem 1.2rem 1.15rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
  }
  .proof-lead { margin: 0 0 0.6rem; font-weight: 500; }
  .proof-points {
    margin: 0 0 0.85rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }
  .proof-points li { font-size: 0.9rem; color: var(--ink-soft); }
  .proof-points strong { color: var(--ink); font-weight: 600; }
  .proof-cta {
    font-family: var(--mono, monospace);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-deep);
  }
</style>
